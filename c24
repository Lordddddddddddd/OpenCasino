# Конфигурация для казино "/warp 24"
warp:
  name: "/warp 24"
  type: "transporter"   # Механизм телепортации через транспортер
  style: "casino slots" # Тематическое оформление: казино, слоты
  description: >
    Добро пожаловать в Казино "/warp 24" – место, где азарт встречается с технологией!
    Нажав /warp 24, ты сможешь оказаться в зале, оформленном в стиле классических игровых автоматов:
    мерцающие неоновые огни, вращающиеся слоты, звуки выигрыша и, конечно, возможность испытать удачу!
  effects:
    - visual: "Неоновый свет, анимация вращения слотов при активации транспортера"
    - audio: "Звуковые эффекты удачи: звон монет, джекпот"
  commands:
    onEnter: "ActivateSlotAnimation(); PlayWinningSounds();"
