-- Подключаем необходимые модули OpenComputers
local component = require("component")
local event = require("event")
local sides = require("sides")
local os = require("os")
local math = require("math")

-- Настроим стороны транспозера:
local inputSide     = sides.top    -- сундук, куда игрок кладёт алмаз для ставки
local trashSide     = sides.back   -- скрытый сундук, куда забирается алмаз (ставка "сгорает")
local prizeChestSide= sides.right  -- сундук с призами (предварительно загруженный, например, с элитными предметами)
local winChestSide  = sides.bottom -- сундук, куда выдаётся выигрыш

-- Функция для поиска алмаза в сундуке ставки
local function findDiamond()
  local size = component.transposer.getInventorySize(inputSide)
  for slot = 1, size do
    local item = component.transposer.getStackInSlot(inputSide, slot)
    if item and item.name == "minecraft:diamond" then
      return slot, item.size
    end
  end
  return nil, 0
end

-- Функция для удаления алмаза из сундука ставки (перемещаем его в скрытый, мусорный сундук)
local function removeDiamond(slot)
  local item = component.transposer.getStackInSlot(inputSide, slot)
  if item then
    -- Передаём все найденные предметы из указанного слота (ставка может состоять из нескольких алмазов)
    local count = item.size
    component.transposer.transferItem(inputSide, slot, trashSide, 1, count)
  end
end

-- Функция для выдачи выигрыша: перемещаем приз из источника в призовой сундук
local function winGame()
  -- В данном примере берём приз из первого слота призового сундука. Если у вас больше вариантов, можно добавить рандомизацию.
  local prizeSlot = 1
  local prizeItem = component.transposer.getStackInSlot(prizeChestSide, prizeSlot)
  if prizeItem then
    -- Переносим один экземпляр приза. Если нужно больше, можно изменить параметр count.
    local count = 1
    local transferred = component.transposer.transferItem(prizeChestSide, prizeSlot, winChestSide, 1, count)
    if transferred > 0 then
      print("Приз выдан!")
    else
      print("Ошибка выдачи приза! Проверьте сундук с призами.")
    end
  else
    print("Призовой сундук пуст или отсутствует предмет в нужном слоте!")
  end
end

-- Функция игры – простая слот-машина
local function playSlotMachine()
  print("Игра начинается... Удачи!")
  -- Обновляем генератор случайных чисел
  math.randomseed(os.time())
  local reel1 = math.random(1, 3)
  local reel2 = math.random(1, 3)
  local reel3 = math.random(1, 3)
  
  -- Выводим результаты "вращений"
  print("Выпали: " .. reel1 .. "  " .. reel2 .. "  " .. reel3)
  
  -- Определяем выигрыш (если все три числа совпадают)
  if reel1 == reel2 and reel2 == reel3 then
    print("Поздравляем, Вы выиграли!")
    winGame()
  else
    print("Вы проиграли. Попробуйте снова!")
  end
end

-- Основной цикл системы казино
print("Казино /warp 24 запущено. Ожидание ставки (алмаз) ...")
while true do
  -- Проверяем входной сундук на наличие алмаза
  local slot, count = findDiamond()
  if slot then
    print("Обнаружен алмаз в слоте " .. slot .. ". Начинаем игру!")
    removeDiamond(slot)   -- забираем ставку
    playSlotMachine()     -- запускаем игру
    print("=== Ожидание следующей ставки ===")
    os.sleep(2)         -- небольшая задержка между играми
  end
  os.sleep(1)           -- опрашиваем сундук каждую секунду
end
