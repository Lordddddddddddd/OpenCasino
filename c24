-------------------------------------------------
-- Casino /warp 24 – Улучшенный 3D интерфейс
-- Версия с 3D-эффектами: баннер, кнопки, оконная графика
-------------------------------------------------

local component = require("component")
local term = require("term")
local os = require("os")
local event = require("event")
local math = require("math")
local gpu = component.gpu

-- Получаем разрешение экрана
local w, h = gpu.getResolution()

-------------------------------------------------
-- Функция для рисования 3D-окна (панели)
-- x, y      — верхний левый угол
-- width, height — размеры панели
-- primaryColor  — основной (панель) цвет
-- shadowColor   — цвет тени (имитация глубины)
local function draw3DBox(x, y, width, height, primaryColor, shadowColor)
  -- Рисуем основной прямоугольник панели
  gpu.setBackground(primaryColor)
  gpu.fill(x, y, width, height, " ")
  
  -- Рисуем правую тень (сдвиг вправо)
  gpu.setBackground(shadowColor)
  gpu.fill(x + width, y + 1, 2, height, " ")
  
  -- Рисуем нижнюю тень (сдвиг вниз)
  gpu.fill(x + 2, y + height, width, 2, " ")
  
  -- Сброс цвета фона
  gpu.setBackground(0x000000)
end

-------------------------------------------------
-- Функция для рисования текста с эффектом тени (drop shadow)
-- text      — текст
-- x, y      — координаты
-- color     — основной цвет текста
-- shadowColor — цвет тени
local function draw3DText(text, x, y, color, shadowColor)
  -- Рисуем тень: смещенный ниже и вправо
  gpu.setForeground(shadowColor)
  term.setCursor(x + 1, y + 1)
  io.write(text)
  
  -- Рисуем основной текст
  gpu.setForeground(color)
  term.setCursor(x, y)
  io.write(text)
  
  gpu.setForeground(0xFFFFFF)
end

-------------------------------------------------
-- Функция для отрисовки 3D баннера казино
local function draw3DBanner()
  local bannerText = "CASINO /warp 24"
  local bannerWidth = #bannerText + 10
  local boxX = math.floor((w - bannerWidth) / 2)
  local boxY = 3
  local boxHeight = 5
  
  -- Рисуем 3D окно баннера (синий блок с тенью)
  draw3DBox(boxX, boxY, bannerWidth, boxHeight, 0x1E90FF, 0x0D3A75)
  
  -- Центрируем текст баннера
  local textX = boxX + math.floor((bannerWidth - #bannerText) / 2)
  local textY = boxY + math.floor(boxHeight / 2)
  draw3DText(bannerText, textX, textY, 0xFFFF00, 0x555555)
end

-------------------------------------------------
-- Функция для отображения главного меню в 3D стиле
local function showMainMenu()
  term.clear()
  draw3DBanner()
  
  local menuOptions = {"1. Играть", "2. Статистика", "3. Выход"}
  local menuX = math.floor(w / 2) - 10
  local menuY = 10
  
  for i, option in ipairs(menuOptions) do
    -- Для каждого пункта меню отрисовываем 3D кнопку
    local btnWidth = 20
    local btnHeight = 3
    local btnX = menuX
    local btnY = menuY + (i - 1) * (btnHeight + 1)
    
    -- Рисуем кнопку с эффектом глубины
    draw3DBox(btnX, btnY, btnWidth, btnHeight, 0x2E8B57, 0x1F5F3A)
    
    local textX = btnX + math.floor((btnWidth - #option) / 2)
    local textY = btnY + math.floor(btnHeight / 2)
    draw3DText(option, textX, textY, 0xFFFFFF, 0x000000)
  end
  
  term.setCursor(1, h)
  io.write("Выберите опцию (1-3): ")
end

-------------------------------------------------
-- Функция для отображения статистики в отдельном 3D окне
local function showStats()
  term.clear()
  local statsBoxWidth = 40
  local statsBoxHeight = 10
  local boxX = math.floor((w - statsBoxWidth) / 2)
  local boxY = math.floor((h - statsBoxHeight) / 2)
  
  draw3DBox(boxX, boxY, statsBoxWidth, statsBoxHeight, 0x8A2BE2, 0x431C7C)  -- Фиолетовый блок с тенями
  
  draw3DText("СТАТИСТИКА:", boxX + 3, boxY + 2, 0xFFFF00, 0x444444)
  -- Пример статистических данных
  draw3DText("Спины: 123", boxX + 3, boxY + 4, 0xFFFFFF, 0x444444)
  draw3DText("Выигрыши: 45", boxX + 3, boxY + 5, 0xFFFFFF, 0x444444)
  draw3DText("Проигрыши: 78", boxX + 3, boxY + 6, 0xFFFFFF, 0x444444)
  draw3DText("Уровень: 5", boxX + 3, boxY + 7, 0xFFFFFF, 0x444444)
  term.setCursor(1, h)
  io.write("Нажмите Enter для возврата...")
  io.read()
end

-------------------------------------------------
-- Заглушка для игрового процесса (пример 3D интерфейса)
local function startGame()
  term.clear()
  draw3DBanner()
  local msg = "Игра начинается!"
  draw3DText(msg, math.floor(w/2) - math.floor(#msg/2), math.floor(h/2), 0x00FF00, 0x444444)
  term.setCursor(1, h)
  io.write("Нажмите Enter для возврата в меню...")
  io.read()
end

-------------------------------------------------
-- Главный цикл программы с выразительным 3D интерфейсом
local function mainLoop()
  while true do
    showMainMenu()
    local choice = io.read()
    if choice == "1" then
      startGame()
    elseif choice == "2" then
      showStats()
    elseif choice == "3" then
      term.clear()
      print("Спасибо за игру!")
      break
    else
      print("Неверный выбор. Попробуйте снова.")
      os.sleep(1)
    end
  end
end

-------------------------------------------------
-- Запуск программы
term.clear()
mainLoop()
