local function appFileManager()
  updateDesktop() drawTaskbar()
  local win = createWindow("Проводник", 20, 10, 60, 20, nil)
  local currentPath = "/"
  local fileList = {}

  local function refreshFiles()
    fileList = {}
    for name, attr in filesystem.list(currentPath) do
      table.insert(fileList, name)
    end
  end
  refreshFiles()

  local running = true
  local function renderFileManager(win)
    gpu.setBackground(theme.window)
    for i, file in ipairs(fileList) do
      drawText(win.x + 2, win.y + i, file, theme.text)
    end
  end

  win.appFunc = renderFileManager

  while running do
    drawAllWindows() drawTaskbar()
    local e, addr, x, y, code = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, x, y)
      if action == "close" then
        running = false
      elseif action == "minimize" then
        win.minimized = true
      elseif action == "maximize" then
        if not win.maximized then
          win.origX = win.x; win.origY = win.y
          win.origWidth = win.width; win.origHeight = win.height
          win.x = 1; win.y = 1
          win.width = screenWidth; win.height = screenHeight - taskbarHeight
          win.maximized = true
        else
          win.x = win.origX; win.y = win.origY
          win.width = win.origWidth; win.height = win.origHeight
          win.maximized = false
        end
      elseif win.minimized then
        win.minimized = false
      end
      if not (x >= win.x and x < win.x + win.width and y >= win.y and y < win.y + win.height) then
        running = false
      end
    end
  end

  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

