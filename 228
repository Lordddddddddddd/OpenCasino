local function appLaunchFile()
  updateDesktop() drawTaskbar()
  local win = createWindow("Запуск файла", 30, 10, 50, 15, nil)
  drawWindow(win)
  drawText(win.x + 2, win.y + 2, "Введите путь к файлу:", theme.text)
  
  local filePath = ""
  local running = true
  while running do
    local e, addr, x, y, code = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, x, y)
      if action == "close" then
        running = false
        break
      end
    elseif e == "key_down" then
      if code == keyboard.keys.enter then
        running = false
      elseif code == keyboard.keys.back then
        filePath = filePath:sub(1, -2)
      elseif code == keyboard.keys.escape then
        running = false
        filePath = ""
      else
        filePath = filePath .. string.char(code or 0)
      end
      drawRect(win.x + 2, win.y + 3, win.width - 4, 1, theme.window)
      drawText(win.x + 2, win.y + 3, filePath, theme.text)
    end
  end
  
  closeWindow(win.id)
  if #filePath > 0 then
    drawText(2, math.floor(screenHeight/2), "Запуск файла: " .. filePath, theme.text)
    os.sleep(1)
    shell.execute(filePath)
  end
  updateDesktop() drawTaskbar()
end

