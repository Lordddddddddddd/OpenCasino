local function drawDesktopIcons()
  for _, iconInfo in ipairs(desktopIcons) do
    for i = 1, #iconInfo.icon do
      drawText(iconInfo.x, iconInfo.y + i - 1, iconInfo.icon[i], theme.highlight)
    end
    local iconWidth = #iconInfo.icon[1]
    local labelX = iconInfo.x - math.floor((#iconInfo.label - iconWidth) / 2)
    drawText(labelX, iconInfo.y + #iconInfo.icon, iconInfo.label, theme.text)
  end
end

----------------------------------------------------------------------
-- Панель задач и рабочий стол
----------------------------------------------------------------------

local taskbarHeight = 1

local function drawTaskbar()
  gpu.setBackground(theme.taskbar)
  gpu.fill(1, screenHeight - taskbarHeight + 1, screenWidth, taskbarHeight, " ")
  drawText(2, screenHeight - taskbarHeight + 1, "[ Start ]", theme.text)
  local timeStr = os.date("%H:%M:%S")
  drawText(screenWidth - 8, screenHeight - taskbarHeight + 1, timeStr, theme.text)
end

local function updateDesktop()
  clearScreen()
  drawRect(1, 1, screenWidth, screenHeight, theme.desktop)
  drawDesktopIcons()
end

