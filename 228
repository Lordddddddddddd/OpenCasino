-- Подключение необходимых модулей OpenComputers
local component       = require("component")
local term            = require("term")
local event           = require("event")
local filesystem      = require("filesystem")
local keyboard        = require("keyboard")
local os              = require("os")
local shell           = require("shell")
local serialization   = require("serialization")
local gpu             = component.gpu

-- Определение размеров экрана
local screenWidth, screenHeight = gpu.getResolution()

-- Тема (цветовая схема)
local theme = {
  desktop    = 0x1D1F21,  -- фон рабочего стола
  window     = 0xC0C0C0,  -- фон окон
  titleBar   = 0x0078D7,  -- заголовок окна
  taskbar    = 0x0078D7,  -- панель задач
  button     = 0xE1E1E1,  -- края и кнопки
  text       = 0x000000,  -- цвет текста
  highlight  = 0xFFD700   -- выделение
}

----------------------------------------------------------------------
-- Функции отрисовки и вспомогательные процедуры
----------------------------------------------------------------------

-- Очистка экрана и установка фонового цвета рабочего стола
local function clearScreen()
  term.clear()
  gpu.setBackground(theme.desktop)
  gpu.fill(1, 1, screenWidth, screenHeight, " ")
end

-- Заполнение прямоугольной области символом с указанным цветом
local function fillRect(x, y, w, h, char, col)
  gpu.setForeground(col)
  for i = 0, h - 1 do
    gpu.set(x, y + i, string.rep(char, w))
  end
end

-- Отрисовка прямоугольника с заданным фоновым цветом
local function drawRect(x, y, w, h, col)
  gpu.setBackground(col)
  gpu.fill(x, y, w, h, " ")
end

-- Вывод текста по координатам. Если указан цвет фона, устанавливает его.
local function drawText(x, y, text, fg, bg)
  gpu.setForeground(fg or theme.text)
  if bg then gpu.setBackground(bg) end
  gpu.set(x, y, text)
end

-- Вывод центрированного текста в области указанной ширины
local function drawCenteredText(x, y, w, text, fg, bg)
  local startx = x + math.floor((w - #text) / 2)
  drawText(startx, y, text, fg, bg)
end

----------------------------------------------------------------------
-- Менеджер окон: создание, отрисовка, управление и закрытие окон
----------------------------------------------------------------------

local windows = {}       -- таблица с окнами
local windowID = 1       -- уникальный ID для каждого окна

-- Функция создания нового окна
local function createWindow(title, x, y, w, h, appFunc)
  local win = {
    id = windowID,
    title = title,
    x = x,
    y = y,
    width = w,
    height = h,
    appFunc = appFunc,  -- функция, отвечающая за отображение содержимого окна
    active = true,
    focused = false,
  }
  windowID = windowID + 1
  table.insert(windows, win)
  return win
end

-- Отрисовка отдельного окна (фона, заголовка и рамки)
local function drawWindow(win)
  -- Отрисовка фона окна
  drawRect(win.x, win.y, win.width, win.height, theme.window)
  -- Отрисовка строки заголовка
  gpu.setBackground(theme.titleBar)
  gpu.fill(win.x, win.y, win.width, 1, " ")
  drawText(win.x + 2, win.y, " " .. win.title .. " ", theme.text)
  -- Рамка окна
  gpu.setForeground(theme.button)
  for i = win.x, win.x + win.width - 1 do
    gpu.set(i, win.y, "─")
    gpu.set(i, win.y + win.height - 1, "─")
  end
  for j = win.y, win.y + win.height - 1 do
    gpu.set(win.x, j, "│")
    gpu.set(win.x + win.width - 1, j, "│")
  end
  gpu.set(win.x, win.y, "┌")
  gpu.set(win.x + win.width - 1, win.y, "┐")
  gpu.set(win.x, win.y + win.height - 1, "└")
  gpu.set(win.x + win.width - 1, win.y + win.height - 1, "┘")
  -- Если функция приложения определена, вызываем её для отрисовки содержимого
  if win.appFunc then
    win.appFunc(win)
  end
end

-- Закрытие окна по его ID
local function closeWindow(id)
  for i, win in ipairs(windows) do
    if win.id == id then
      table.remove(windows, i)
      break
    end
  end
end

-- Отрисовка всех активных окон
local function drawAllWindows()
  for _, win in ipairs(windows) do
    if win.active then
      drawWindow(win)
    end
  end
end

----------------------------------------------------------------------
-- Панель задач и рабочий стол
----------------------------------------------------------------------

local taskbarHeight = 1  -- высота панели задач (1 строка)

-- Отрисовка панели задач с кнопкой "Start" и текущим временем
local function drawTaskbar()
  gpu.setBackground(theme.taskbar)
  gpu.fill(1, screenHeight - taskbarHeight + 1, screenWidth, taskbarHeight, " ")
  drawText(2, screenHeight - taskbarHeight + 1, "[ Start ]", theme.text)
  local timeStr = os.date("%H:%M:%S")
  drawText(screenWidth - 8, screenHeight - taskbarHeight + 1, timeStr, theme.text)
end

-- Обновление рабочего стола: фон и иконки ярлыков
local function updateDesktop()
  clearScreen()
  -- Отрисовка основного фона рабочего стола
  drawRect(1, 1, screenWidth, screenHeight, theme.desktop)
  -- Ярлыки на рабочем столе
  drawText(2, 2, "Мой компьютер", theme.text)
  drawText(2, 4, "Блокнот", theme.text)
  drawText(2, 6, "Терминал", theme.text)
  drawText(2, 8, "Проводник", theme.text)
  drawText(2, 10, "Настройки", theme.text)
  drawText(2, 12, "Систем. инфо", theme.text)
end

