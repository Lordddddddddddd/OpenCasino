-- Подключение необходимых модулей OpenComputers
local component       = require("component")
local term            = require("term")
local event           = require("event")
local filesystem      = require("filesystem")
local keyboard        = require("keyboard")
local os              = require("os")
local shell           = require("shell")
local serialization   = require("serialization")
local gpu             = component.gpu

-- Определение размеров экрана
local screenWidth, screenHeight = gpu.getResolution()

-- Тема (цветовая схема)
local theme = {
  desktop    = 0x1D1F21,  -- фон рабочего стола
  window     = 0xC0C0C0,  -- фон окон
  titleBar   = 0x0078D7,  -- заголовок окна
  taskbar    = 0x0078D7,  -- панель задач
  button     = 0xE1E1E1,  -- края и кнопки
  text       = 0x000000,  -- цвет текста
  highlight  = 0xFFD700   -- выделение для иконок
}

----------------------------------------------------------------------
-- Вспомогательные функции отрисовки
----------------------------------------------------------------------

local function clearScreen()
  term.clear()
  gpu.setBackground(theme.desktop)
  gpu.fill(1, 1, screenWidth, screenHeight, " ")
end

local function fillRect(x, y, w, h, char, col)
  gpu.setForeground(col)
  for i = 0, h - 1 do
    gpu.set(x, y + i, string.rep(char, w))
  end
end

local function drawRect(x, y, w, h, col)
  gpu.setBackground(col)
  gpu.fill(x, y, w, h, " ")
end

local function drawText(x, y, text, fg, bg)
  gpu.setForeground(fg or theme.text)
  if bg then gpu.setBackground(bg) end
  gpu.set(x, y, text)
end

local function drawCenteredText(x, y, w, text, fg, bg)
  local startx = x + math.floor((w - #text) / 2)
  drawText(startx, y, text, fg, bg)
end

----------------------------------------------------------------------
-- Функция проверки управления окном (кнопка закрытия)
----------------------------------------------------------------------
local function checkWindowControls(win, x, y)
  -- Пусть наша кнопка закрытия занимает 3 символа в правом углу заголовка
  if y == win.y and x >= win.x + win.width - 3 and x < win.x + win.width then
    return "close"
  end
  return nil
end

----------------------------------------------------------------------
-- Менеджер окон: создание, отрисовка, управление и закрытие окон
----------------------------------------------------------------------

local windows = {}       -- таблица с окнами
local windowID = 1       -- уникальный ID для окон

local function createWindow(title, x, y, w, h, appFunc)
  local win = {
    id = windowID,
    title = title,
    x = x,
    y = y,
    width = w,
    height = h,
    appFunc = appFunc,  -- функция отрисовки содержимого окна
    active = true,
    focused = false,
  }
  windowID = windowID + 1
  table.insert(windows, win)
  return win
end

local function drawWindow(win)
  -- Отрисовка фона окна
  drawRect(win.x, win.y, win.width, win.height, theme.window)
  -- Отрисовка строки заголовка окна
  gpu.setBackground(theme.titleBar)
  gpu.fill(win.x, win.y, win.width, 1, " ")
  drawText(win.x + 2, win.y, " " .. win.title .. " ", theme.text)
  -- Отрисовка кнопки закрытия (иконка "X") в правом углу заголовка
  drawText(win.x + win.width - 3, win.y, "X", theme.text, theme.titleBar)
  -- Рамка окна
  gpu.setForeground(theme.button)
  for i = win.x, win.x + win.width - 1 do
    gpu.set(i, win.y, "─")
    gpu.set(i, win.y + win.height - 1, "─")
  end
  for j = win.y, win.y + win.height - 1 do
    gpu.set(win.x, j, "│")
    gpu.set(win.x + win.width - 1, j, "│")
  end
  gpu.set(win.x, win.y, "┌")
  gpu.set(win.x + win.width - 1, win.y, "┐")
  gpu.set(win.x, win.y + win.height - 1, "└")
  gpu.set(win.x + win.width - 1, win.y + win.height - 1, "┘")
  
  if win.appFunc then
    win.appFunc(win)  -- Отрисовка содержимого окна
  end
end

local function closeWindow(id)
  for i, win in ipairs(windows) do
    if win.id == id then
      table.remove(windows, i)
      break
    end
  end
end

local function drawAllWindows()
  for _, win in ipairs(windows) do
    if win.active then
      drawWindow(win)
    end
  end
end

