-- Подключение модулей OpenComputers
local component       = require("component")
local term            = require("term")
local event           = require("event")
local filesystem      = require("filesystem")
local keyboard        = require("keyboard")
local os              = require("os")
local shell           = require("shell")
local serialization   = require("serialization")
local gpu             = component.gpu

-- Определение размеров экрана
local screenWidth, screenHeight = gpu.getResolution()

-- Тема (цветовая схема)
local theme = {
  desktop    = 0x1E1E1E,  -- фон рабочего стола
  window     = 0xC0C0C0,  -- фон окон (контент)
  titleBar   = 0x0078D7,  -- цвет заголовка окна
  taskbar    = 0x0078D7,  -- панель задач
  buttonFg   = 0xFFFFFF,  -- текст на кнопках
  buttonBg   = 0xD9534F,  -- фон кнопки (закрытия)
  controlBg  = 0xE1E1E1,  -- фон остальных кнопок
  text       = 0xFFFFFF,  -- цвет текста для окон
  iconColor  = 0xFFD700   -- цвет для иконок
}

----------------------------------------------------------------------
-- Функции отрисовки
----------------------------------------------------------------------

local function clearScreen()
  term.clear()
  gpu.setBackground(theme.desktop)
  gpu.fill(1, 1, screenWidth, screenHeight, " ")
end

local function fillRect(x, y, w, h, char, col)
  gpu.setForeground(col)
  for i = 0, h - 1 do
    gpu.set(x, y + i, string.rep(char, w))
  end
end

local function drawRect(x, y, w, h, col)
  gpu.setBackground(col)
  gpu.fill(x, y, w, h, " ")
end

local function drawText(x, y, text, fg, bg)
  gpu.setForeground(fg or theme.text)
  if bg then gpu.setBackground(bg) end
  gpu.set(x, y, text)
end

local function drawCenteredText(x, y, w, text, fg, bg)
  local startx = x + math.floor((w - #text)/2)
  drawText(startx, y, text, fg, bg)
end

----------------------------------------------------------------------
-- Функции управления окнами (контроль кнопок)
----------------------------------------------------------------------

-- Каждая кнопка занимает 4 символа в строке заголовка.
-- Распределяем кнопки по правому краю заголовка:
-- Минмизировать: диапазон [win.x+win.width-12, win.x+win.width-9)
-- Максимизировать: [win.x+win.width-8, win.x+win.width-5)
-- Закрыть: [win.x+win.width-4, win.x+win.width)
local function checkWindowControls(win, x, y)
  if y == win.y then
    local closeStart = win.x + win.width - 4
    local maxStart = win.x + win.width - 8
    local minStart = win.x + win.width - 12
    if x >= closeStart and x < win.x + win.width then
      return "close"
    elseif x >= maxStart and x < closeStart - 4 then
      -- Если вдруг ширина не позволяет, то вынуждены объединить кнопки
      return "maximize"
    elseif x >= maxStart and x < win.x + win.width - 4 then
      return "maximize"
    elseif x >= minStart and x < maxStart then
      return "minimize"
    end
  end
  return nil
end

----------------------------------------------------------------------
-- Менеджер окон
----------------------------------------------------------------------

local windows = {}       -- таблица окон
local windowID = 1       -- уникальный идентификатор окна

-- Функция создания окна; сохраняем оригинальные координаты для восстановления
local function createWindow(title, x, y, w, h, appFunc)
  local win = {
    id = windowID,
    title = title,
    x = x,
    y = y,
    width = w,
    height = h,
    appFunc = appFunc,  -- функция, отвечающая за отрисовку содержимого
    active = true,
    minimized = false,
    maximized = false,
    origX = x,
    origY = y,
    origWidth = w,
    origHeight = h,
  }
  windowID = windowID + 1
  table.insert(windows, win)
  return win
end

-- Функция рисует окно с улучшенным дизайном и кнопками управления
local function drawWindow(win)
  -- Рисуем заголовок
  gpu.setBackground(theme.titleBar)
  gpu.fill(win.x, win.y, win.width, 1, " ")
  drawText(win.x + 2, win.y, " " .. win.title .. " ", theme.text)
  -- Отрисовка кнопок управления:
  -- Кнопка минимизации ([-])
  drawText(win.x + win.width - 12, win.y, "[-]", theme.buttonFg, theme.controlBg)
  -- Кнопка максимизации ([□])
  drawText(win.x + win.width - 8, win.y, "[□]", theme.buttonFg, theme.controlBg)
  -- Кнопка закрытия ([X])
  drawText(win.x + win.width - 4, win.y, "[X]", theme.buttonFg, theme.buttonBg)
  
  if not win.minimized then
    -- Отрисовка содержимого окна (фон и рамка)
    drawRect(win.x, win.y + 1, win.width, win.height - 1, theme.window)
    gpu.setForeground(theme.controlBg)
    for i = win.x, win.x + win.width - 1 do
      gpu.set(i, win.y + win.height - 1, "─")
    end
    for j = win.y, win.y + win.height - 1 do
      gpu.set(win.x, j, "│")
      gpu.set(win.x + win.width - 1, j, "│")
    end
    gpu.set(win.x, win.y, "┌")
    gpu.set(win.x + win.width - 1, win.y, "┐")
    gpu.set(win.x, win.y + win.height - 1, "└")
    gpu.set(win.x + win.width - 1, win.y + win.height - 1, "┘")
    if win.appFunc then
      win.appFunc(win)
    end
  else
    -- Если окно минимизировано, рисуем только заголовок с затемнённым фоном
    drawRect(win.x, win.y + 1, win.width, 1, theme.window)
  end
end

local function closeWindow(id)
  for i, win in ipairs(windows) do
    if win.id == id then
      table.remove(windows, i)
      break
    end
  end
end

local function drawAllWindows()
  for _, win in ipairs(windows) do
    if win.active then
      drawWindow(win)
    end
  end
end

