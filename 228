------------------------------
-- Приложение: Блокнот (Notepad)
------------------------------
local function appNotepad()
  updateDesktop()
  drawTaskbar()
  local win = createWindow("Блокнот", 10, 5, 50, 15)
  local textLines = {""}
  local cursorX, cursorY = 1, 1
  local running = true

  local function renderNotepad()
    drawWindow(win)
    gpu.setBackground(theme.window)
    for i, line in ipairs(textLines) do
      drawText(win.x + 2, win.y + i, line, theme.text)
    end
    -- Отрисовка курсора (статичный символ)
    gpu.set(win.x + 2 + cursorX - 1, win.y + cursorY, "_")
  end

  while running do
    renderNotepad()
    local _, _, char, code = event.pull("key_down")
    if code == 28 then  -- Enter
      cursorY = cursorY + 1
      cursorX = 1
      textLines[cursorY] = ""
    elseif code == 14 then  -- Backspace
      if cursorX > 1 then
        local str = textLines[cursorY]
        textLines[cursorY] = str:sub(1, cursorX - 2) .. str:sub(cursorX)
        cursorX = cursorX - 1
      elseif cursorY > 1 then
        cursorX = #textLines[cursorY - 1] + 1
        textLines[cursorY - 1] = textLines[cursorY - 1] .. textLines[cursorY]
        table.remove(textLines, cursorY)
        cursorY = cursorY - 1
      end
    elseif code == 1 then  -- Esc для выхода
      running = false
    else
      local ch = string.char(char)
      textLines[cursorY] = textLines[cursorY] .. ch
      cursorX = cursorX + 1
    end
  end
  closeWindow(win.id)
  updateDesktop()
  drawTaskbar()
end

------------------------------
-- Приложение: Терминал
------------------------------
local function appTerminal()
  updateDesktop()
  drawTaskbar()
  local win = createWindow("Терминал", 15, 8, 60, 20)
  local history = {}
  local inputLine = ""
  local running = true

  local function renderTerminal()
    drawWindow(win)
    gpu.setBackground(theme.window)
    local yOff = 1
    for i, line in ipairs(history) do
      if yOff < win.height - 2 then
        drawText(win.x + 2, win.y + yOff, line, theme.text)
        yOff = yOff + 1
      end
    end
    drawText(win.x + 2, win.y + yOff, "> " .. inputLine, theme.text)
  end

  while running do
    renderTerminal()
    local _, _, key, char, code = event.pull("key_down")
    if code == 28 then  -- Enter
      table.insert(history, "> " .. inputLine)
      inputLine = ""
    elseif code == 14 then  -- Backspace
      inputLine = inputLine:sub(1, -2)
    elseif code == 1 then  -- Esc
      running = false
    else
      inputLine = inputLine .. string.char(char or 0)
    end
    if #history > (win.height - 3) then
      table.remove(history, 1)
    end
  end
  closeWindow(win.id)
  updateDesktop()
  drawTaskbar()
end

------------------------------
-- Приложение: Проводник (File Manager)
------------------------------
local function appFileManager()
  updateDesktop()
  drawTaskbar()
  local win = createWindow("Проводник", 20, 10, 60, 20)
  local currentPath = "/"
  local fileList = {}

  local function refreshFiles()
    fileList = {}
    for name, attr in filesystem.list(currentPath) do
      table.insert(fileList, name)
    end
  end

  refreshFiles()

  local running = true
  local function renderFileManager()
    drawWindow(win)
    gpu.setBackground(theme.window)
    for i, file in ipairs(fileList) do
      drawText(win.x + 2, win.y + i, file, theme.text)
    end
  end

  while running do
    renderFileManager()
    local _, _, x, y, button = event.pull("touch")
    -- Если клик вне границ окна проводника — завершаем приложение
    if not (x >= win.x and x < win.x + win.width and y >= win.y and y < win.y + win.height) then
      running = false
    end
  end
  closeWindow(win.id)
  updateDesktop()
  drawTaskbar()
end

