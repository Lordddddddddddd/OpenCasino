local function appTerminal()
  updateDesktop() drawTaskbar()
  local win = createWindow("Терминал", 15, 8, 60, 20, nil)
  local history = {}
  local inputLine = ""
  local running = true

  local function renderTerminal(win)
    gpu.setBackground(theme.window)
    local yOff = 1
    for i, line in ipairs(history) do
      if yOff < win.height - 2 then
        drawText(win.x + 2, win.y + yOff, line, theme.text)
        yOff = yOff + 1
      end
    end
    drawText(win.x + 2, win.y + yOff, "> " .. inputLine, theme.text)
  end

  win.appFunc = renderTerminal

  while running do
    drawAllWindows() drawTaskbar()
    local e, addr, x, y, code = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, x, y)
      if action == "close" then running = false end
      if win.minimized then
        win.minimized = false
        animateWindowTransition(win, win.origX, win.origY, win.origWidth, win.origHeight, 0.3)
      end
    elseif e == "key_down" then
      if code == keyboard.keys.enter then
        table.insert(history, "> " .. inputLine)
        inputLine = ""
      elseif code == keyboard.keys.back then
        inputLine = inputLine:sub(1, -2)
      elseif code == keyboard.keys.escape then
        running = false
      else
        inputLine = inputLine .. string.char(code or 0)
      end
      if #history > (win.height - 3) then table.remove(history, 1) end
    end
  end

  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

