-- Получение размеров экрана
local screenWidth, screenHeight = gpu.getResolution()

-- Новая тема (современная цветовая гамма)
local theme = {
  desktop      = 0x1C1C1C,  -- глубокий тёмный фон рабочего стола
  window       = 0x2B2B2B,  -- фон окон (контент)
  titleBar     = 0x0A84FF,  -- ярко-голубой (заголовок окна)
  taskbar      = 0x1F1F1F,  -- темно-серый (панель задач)
  buttonFg     = 0xFFFFFF,  -- белый цвет кнопок
  buttonBgClose= 0xFF3B30,  -- красный для кнопки закрытия
  buttonBgMax  = 0x34C759,  -- зелёный для кнопки максимизации
  buttonBgMin  = 0xFFCC00,  -- желтый для кнопки минимизации
  text         = 0xFFFFFF,  -- белый текст
  iconColor    = 0xFFD700   -- яркий золотой для иконок
}

----------------------------------------------------------------------
-- Функции отрисовки экрана и текста
----------------------------------------------------------------------

local function clearScreen()
  term.clear()
  gpu.setBackground(theme.desktop)
  gpu.fill(1, 1, screenWidth, screenHeight, " ")
end

local function fillRect(x, y, w, h, char, col)
  gpu.setForeground(col)
  for i = 0, h - 1 do
    gpu.set(x, y + i, string.rep(char, w))
  end
end

local function drawRect(x, y, w, h, col)
  gpu.setBackground(col)
  gpu.fill(x, y, w, h, " ")
end

local function drawText(x, y, text, fg, bg)
  gpu.setForeground(fg or theme.text)
  if bg then gpu.setBackground(bg) end
  gpu.set(x, y, text)
end

local function drawCenteredText(x, y, w, text, fg, bg)
  local startx = x + math.floor((w - #text) / 2)
  drawText(startx, y, text, fg, bg)
end

----------------------------------------------------------------------
-- Функция обновления экрана: рабочий стол, окна, панель задач
----------------------------------------------------------------------

local function updateScreen()
  clearScreen()
  drawDesktopIcons()
  drawAllWindows()
  drawTaskbar()
end

----------------------------------------------------------------------
-- Функция сглаживания (easing) для анимаций
----------------------------------------------------------------------

local function easeOutSine(t)
  return math.sin((t * math.pi) / 2)
end

----------------------------------------------------------------------
-- Плавная анимация изменения параметров окна
----------------------------------------------------------------------

local function animateWindowTransition(win, targetX, targetY, targetWidth, targetHeight, duration)
  local steps = 20  -- Количество шагов анимации для плавности
  local startX = win.x
  local startY = win.y
  local startWidth = win.width
  local startHeight = win.height
  for i = 1, steps do
    local t = i / steps
    local ease = easeOutSine(t)
    win.x = math.floor(startX + (targetX - startX) * ease)
    win.y = math.floor(startY + (targetY - startY) * ease)
    win.width = math.floor(startWidth + (targetWidth - startWidth) * ease)
    win.height = math.floor(startHeight + (targetHeight - startHeight) * ease)
    updateScreen()
    os.sleep(duration / steps)
  end
  win.x = targetX
  win.y = targetY
  win.width = targetWidth
  win.height = targetHeight
end

----------------------------------------------------------------------
-- Функции управления окнами: кнопки управления (мин, макс, закрыть)
----------------------------------------------------------------------

-- Каждая кнопка занимает 4 символа.
-- Распределяем кнопки в строке заголовка:
-- Минимизация: "[–]" (символ U+2013, можно использовать стандартный минус)
-- Максимизация: "[□]"
-- Закрытие: "[X]"
local function checkWindowControls(win, x, y)
  if y == win.y then
    local closeStart = win.x + win.width - 4
    local maxStart = win.x + win.width - 8
    local minStart = win.x + win.width - 12
    if x >= closeStart and x < win.x + win.width then
      return "close"
    elseif x >= maxStart and x < closeStart - 4 then
      return "maximize"
    elseif x >= minStart and x < maxStart then
      return "minimize"
    end
  end
  return nil
end

----------------------------------------------------------------------
-- Менеджер окон
----------------------------------------------------------------------

local windows = {}       -- таблица всех окон
local windowID = 1       -- уникальный идентификатор для окон

local function createWindow(title, x, y, w, h, appFunc)
  local win = {
    id = windowID,
    title = title,
    x = x,
    y = y,
    width = w,
    height = h,
    appFunc = appFunc,  -- функция отрисовки содержимого окна
    active = true,
    minimized = false,
    maximized = false,
    origX = x, origY = y,
    origWidth = w, origHeight = h,
  }
  windowID = windowID + 1
  table.insert(windows, win)
  return win
end

-- Для улучшения дизайна используем двойные рамки
local function drawWindow(win)
  -- Рисуем заголовок окна с двойной рамкой
  gpu.setBackground(theme.titleBar)
  gpu.fill(win.x, win.y, win.width, 1, " ")
  drawText(win.x + 2, win.y, " " .. win.title .. " ", theme.text)
  -- Рисуем кнопки управления
  drawText(win.x + win.width - 12, win.y, "[-]", theme.buttonFg, theme.buttonBgMin)
  drawText(win.x + win.width - 8, win.y, "[□]", theme.buttonFg, theme.buttonBgMax)
  drawText(win.x + win.width - 4, win.y, "[X]", theme.buttonFg, theme.buttonBgClose)
  
  if not win.minimized then
    -- Рисуем содержимое окна с двойными рамками
    drawRect(win.x, win.y + 1, win.width, win.height - 1, theme.window)
    gpu.setForeground(theme.titleBar)
    -- Верхняя и нижняя рамки
    local horLine = string.rep("═", win.width - 2)
    drawText(win.x + 1, win.y, horLine, theme.titleBar)
    drawText(win.x + 1, win.y + win.height - 1, horLine, theme.titleBar)
    -- Левые и правые рамки
    for j = win.y + 1, win.y + win.height - 2 do
      drawText(win.x, j, "║", theme.titleBar)
      drawText(win.x + win.width - 1, j, "║", theme.titleBar)
    end
    -- Углы
    drawText(win.x, win.y, "╔", theme.titleBar)
    drawText(win.x + win.width - 1, win.y, "╗", theme.titleBar)
    drawText(win.x, win.y + win.height - 1, "╚", theme.titleBar)
    drawText(win.x + win.width - 1, win.y + win.height - 1, "╝", theme.titleBar)
    if win.appFunc then
      win.appFunc(win)
    end
  else
    -- Если окно минимизировано – отображаем только заголовок с затемнённым фоном
    drawRect(win.x, win.y + 1, win.width, 1, theme.window)
  end
end

local function closeWindow(id)
  for i, win in ipairs(windows) do
    if win.id == id then
      table.remove(windows, i)
      break
    end
  end
end

local function drawAllWindows()
  for _, win in ipairs(windows) do
    if win.active then
      drawWindow(win)
    end
  end
end

