-- ===============================
--  Тема и настройки дизайна
-- ===============================
local theme = {
  desktop      = 0x1C1C1C,    -- Глубокий тёмный фон рабочего стола
  window       = 0x2B2B2B,    -- Фон содержимого окон
  titleBar     = 0x0A84FF,    -- Ярко-голубой заголовок окна
  taskbar      = 0x1F1F1F,    -- Фон панели задач
  buttonFg     = 0xFFFFFF,    -- Текст кнопок (белый)
  buttonBgClose= 0xFF3B30,    -- Красный фон для кнопки закрытия
  buttonBgMax  = 0x34C759,    -- Зелёный фон для кнопки максимизации
  buttonBgMin  = 0xFFCC00,    -- Желтый фон для кнопки минимизации
  text         = 0xFFFFFF,    -- Основной цвет текста
  iconColor    = 0xFFD700     -- Яркий золотой для иконок
}

-- Функция динамического обновления темы (например, меняем цвет панели задач каждую минуту)
local function updateDynamicTheme()
  -- Эмулируем динамическое изменение темы на основе текущей минуты
  local minute = tonumber(os.date("%M"))
  if minute % 2 == 0 then
    theme.taskbar = 0x1F1F1F
    theme.titleBar = 0x0A84FF
  else
    theme.taskbar = 0x2F2F2F
    theme.titleBar = 0x147EFB
  end
end

-- ===============================
--  Функции отрисовки экрана и текста
-- ===============================
local function clearScreen()
  term.clear()
  gpu.setBackground(theme.desktop)
  gpu.fill(1, 1, screenWidth, screenHeight, " ")
end

local function fillRect(x, y, w, h, char, col)
  gpu.setForeground(col)
  for i = 0, h - 1 do
    gpu.set(x, y + i, string.rep(char, w))
  end
end

local function drawRect(x, y, w, h, col)
  gpu.setBackground(col)
  gpu.fill(x, y, w, h, " ")
end

local function drawText(x, y, text, fg, bg)
  gpu.setForeground(fg or theme.text)
  if bg then gpu.setBackground(bg) end
  gpu.set(x, y, text)
end

local function drawCenteredText(x, y, w, text, fg, bg)
  local startx = x + math.floor((w - #text) / 2)
  drawText(startx, y, text, fg, bg)
end

-- ===============================
--  Функция обновления экрана (рабочий стол, окна, панель задач)
-- ===============================
local function updateScreen()
  updateDynamicTheme()
  clearScreen()
  drawDesktopIcons()
  drawAllWindows()
  drawTaskbar()
end

-- ===============================
--  Функция сглаживания (easing) для анимаций
-- ===============================
local function easeOutSine(t)
  return math.sin((t * math.pi) / 2)
end

-- ===============================
--  Функция плавной анимации изменения параметров окна
-- ===============================
local function animateWindowTransition(win, targetX, targetY, targetWidth, targetHeight, duration)
  local steps = 20
  local startX = win.x
  local startY = win.y
  local startWidth = win.width
  local startHeight = win.height
  for i = 1, steps do
    local t = i / steps
    local ease = easeOutSine(t)
    win.x = math.floor(startX + (targetX - startX) * ease)
    win.y = math.floor(startY + (targetY - startY) * ease)
    win.width = math.floor(startWidth + (targetWidth - startWidth) * ease)
    win.height = math.floor(startHeight + (targetHeight - startHeight) * ease)
    updateScreen()
    os.sleep(duration / steps)
  end
  win.x = targetX
  win.y = targetY
  win.width = targetWidth
  win.height = targetHeight
end

