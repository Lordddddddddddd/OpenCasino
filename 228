------------------------------
-- Приложение: Запуск файла
------------------------------
local function appLaunchFile()
  updateDesktop() drawTaskbar()
  local win = createWindow("Запуск файла", 30, 10, 50, 15)
  drawWindow(win)
  drawText(win.x + 2, win.y + 2, "Введите путь к файлу:", theme.text)
  
  local filePath = ""
  local running = true
  while running do
    local e, addr, p1, p2, p3 = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, p1, p2)
      if action == "close" then
        running = false
        break
      end
    elseif e == "key_down" then
      if p3 == 28 then
        running = false
      elseif p3 == 14 then
        filePath = filePath:sub(1, -2)
      elseif p3 == 1 then
        running = false
        filePath = ""
      else
        filePath = filePath .. string.char(p3 or 0)
      end
      drawRect(win.x + 2, win.y + 3, win.width - 4, 1, theme.window)
      drawText(win.x + 2, win.y + 3, filePath, theme.text)
    end
  end
  closeWindow(win.id)
  if #filePath > 0 then
    drawText(2, math.floor(screenHeight/2), "Запуск файла: " .. filePath, theme.text)
    os.sleep(1)
    shell.execute(filePath)
  end
  updateDesktop() drawTaskbar()
end

----------------------------------------------------------------------
-- Обработчик стартового меню
----------------------------------------------------------------------

local function showStartMenu()
  local menuW, menuH = 25, 7
  local menuX, menuY = 2, screenHeight - taskbarHeight - menuH
  drawRect(menuX, menuY, menuW, menuH, theme.window)
  drawText(menuX + 2, menuY + 1, "1. Блокнот", theme.text)
  drawText(menuX + 2, menuY + 2, "2. Терминал", theme.text)
  drawText(menuX + 2, menuY + 3, "3. Проводник", theme.text)
  drawText(menuX + 2, menuY + 4, "4. Настройки", theme.text)
  drawText(menuX + 2, menuY + 5, "5. Инфо", theme.text)
  
  local e, addr, x, y, button = event.pull("touch")
  if x >= menuX and x < menuX + menuW and y >= menuY and y < menuY + menuH then
    if y == menuY + 1 then
      appNotepad()
    elseif y == menuY + 2 then
      appTerminal()
    elseif y == menuY + 3 then
      appFileManager()
    elseif y == menuY + 4 then
      appSettings()
    elseif y == menuY + 5 then
      appSystemInfo()
    end
  end
  updateDesktop() drawTaskbar()
end

----------------------------------------------------------------------
-- Глобальный слушатель клавиш
----------------------------------------------------------------------

local function globalKeyListener()
  while true do
    local e, addr, char, code = event.pull("key_down")
    if code == keyboard.keys.f5 then
      drawText(1, math.floor(screenHeight/2), "Перезагрузка...", 0x00FF00)
      os.sleep(2)
      os.exit()
    elseif code == keyboard.keys.f6 then
      drawText(1, math.floor(screenHeight/2), "Выключение...", 0xFF0000)
      os.sleep(2)
      os.exit()
    end
    os.sleep(0.1)
  end
end

----------------------------------------------------------------------
-- Основной цикл рабочего стола
----------------------------------------------------------------------

local function desktopLoop()
  updateDesktop() drawTaskbar()
  while true do
    local e, addr, x, y, button = event.pull("touch")
    -- Если клик по кнопке "Start" на панели задач
    if y == screenHeight - taskbarHeight + 1 and x >= 2 and x < 10 then
      showStartMenu()
    else
      for _, iconInfo in ipairs(desktopIcons) do
        local iconW = #iconInfo.icon[1]
        local iconH = #iconInfo.icon + 1
        if x >= iconInfo.x and x < iconInfo.x + iconW and y >= iconInfo.y and y < iconInfo.y + iconH then
          if iconInfo.app == "notepad" then
            appNotepad()
          elseif iconInfo.app == "terminal" then
            appTerminal()
          elseif iconInfo.app == "fileManager" then
            appFileManager()
          elseif iconInfo.app == "settings" then
            appSettings()
          elseif iconInfo.app == "systemInformation" then
            appSystemInfo()
          elseif iconInfo.app == "launchFile" then
            appLaunchFile()
          end
        end
      end
    end
    drawAllWindows() drawTaskbar()
  end
end

----------------------------------------------------------------------
-- Фоновый процесс часов
----------------------------------------------------------------------

local function clockUpdater()
  while true do
    local timeStr = os.date("%H:%M:%S")
    drawText(screenWidth - 8, screenHeight - taskbarHeight + 1, timeStr, theme.text)
    os.sleep(1)
  end
end

----------------------------------------------------------------------
-- Основной запуск ОС с параллельными процессами
----------------------------------------------------------------------

local parallelAvailable, parallel = pcall(require, "parallel")
local function main()
  clearScreen() updateDesktop() drawTaskbar()
  if parallelAvailable then
    parallel.waitForAny(desktopLoop, globalKeyListener, clockUpdater)
  else
    while true do desktopLoop() end
  end
end

