------------------------------
-- Приложение: Блокнот (Notepad)
------------------------------
local function appNotepad()
  updateDesktop() drawTaskbar()
  local win = createWindow("Блокнот", 10, 5, 50, 15)
  local textLines = {""}
  local cursorX, cursorY = 1, 1
  local running = true

  local function renderNotepad()
    drawWindow(win)
    gpu.setBackground(theme.window)
    for i, line in ipairs(textLines) do
      drawText(win.x + 2, win.y + i, line, theme.text)
    end
    gpu.set(win.x + 2 + cursorX - 1, win.y + cursorY, "_")
  end

  while running do
    renderNotepad()
    local e, addr, p1, p2, p3 = event.pull()  -- ждем любое событие
    if e == "touch" then
      local action = checkWindowControls(win, p1, p2)
      if action == "close" then
        running = false
      end
    elseif e == "key_down" then
      if p3 == 28 then  -- Enter
        cursorY = cursorY + 1
        cursorX = 1
        textLines[cursorY] = ""
      elseif p3 == 14 then  -- Backspace
        if cursorX > 1 then
          local str = textLines[cursorY]
          textLines[cursorY] = str:sub(1, cursorX - 2) .. str:sub(cursorX)
          cursorX = cursorX - 1
        elseif cursorY > 1 then
          cursorX = #textLines[cursorY - 1] + 1
          textLines[cursorY - 1] = textLines[cursorY - 1] .. textLines[cursorY]
          table.remove(textLines, cursorY)
          cursorY = cursorY - 1
        end
      elseif p3 == 1 then  -- Esc
        running = false
      else
        local ch = string.char(p3)
        textLines[cursorY] = textLines[cursorY] .. ch
        cursorX = cursorX + 1
      end
    end
  end
  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

------------------------------
-- Приложение: Терминал
------------------------------
local function appTerminal()
  updateDesktop() drawTaskbar()
  local win = createWindow("Терминал", 15, 8, 60, 20)
  local history = {}
  local inputLine = ""
  local running = true

  local function renderTerminal()
    drawWindow(win)
    gpu.setBackground(theme.window)
    local yOff = 1
    for i, line in ipairs(history) do
      if yOff < win.height - 2 then
        drawText(win.x + 2, win.y + yOff, line, theme.text)
        yOff = yOff + 1
      end
    end
    drawText(win.x + 2, win.y + yOff, "> " .. inputLine, theme.text)
  end

  while running do
    renderTerminal()
    local e, addr, p1, p2, p3 = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, p1, p2)
      if action == "close" then
        running = false
      end
    elseif e == "key_down" then
      if p3 == 28 then
        table.insert(history, "> " .. inputLine)
        inputLine = ""
      elseif p3 == 14 then
        inputLine = inputLine:sub(1, -2)
      elseif p3 == 1 then
        running = false
      else
        inputLine = inputLine .. string.char(p3 or 0)
      end
      if #history > (win.height - 3) then table.remove(history, 1) end
    end
  end
  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

------------------------------
-- Приложение: Проводник (File Manager)
------------------------------
local function appFileManager()
  updateDesktop() drawTaskbar()
  local win = createWindow("Проводник", 20, 10, 60, 20)
  local currentPath = "/"
  local fileList = {}

  local function refreshFiles()
    fileList = {}
    for name, attr in filesystem.list(currentPath) do
      table.insert(fileList, name)
    end
  end

  refreshFiles()
  local running = true

  local function renderFileManager()
    drawWindow(win)
    gpu.setBackground(theme.window)
    for i, file in ipairs(fileList) do
      drawText(win.x + 2, win.y + i, file, theme.text)
    end
  end

  while running do
    renderFileManager()
    local e, addr, p1, p2, p3 = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, p1, p2)
      if action == "close" then
        running = false
      end
    end
    if e == "touch" then
      if not (p1 >= win.x and p1 < win.x + win.width and p2 >= win.y and p2 < win.y + win.height) then
        running = false
      end
    end
  end
  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

