local taskbarHeight = 1

local function drawTaskbar()
  gpu.setBackground(theme.taskbar)
  gpu.fill(1, screenHeight - taskbarHeight + 1, screenWidth, taskbarHeight, " ")
  drawText(2, screenHeight - taskbarHeight + 1, "[ Start ]", theme.text)
  local timeStr = os.date("%H:%M:%S")
  drawText(screenWidth - 8, screenHeight - taskbarHeight + 1, timeStr, theme.text)
end

local function updateDesktop()
  clearScreen()
  drawRect(1, 1, screenWidth, screenHeight, theme.desktop)
  drawDesktopIcons()
end

