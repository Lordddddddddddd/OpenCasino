local function appFileManager()
  updateDesktop() drawTaskbar()
  local win = createWindow("Проводник", 20, 10, 60, 20, nil)
  local currentPath = "/"
  local fileList = {}

  local function refreshFiles()
    fileList = {}
    for name, attr in filesystem.list(currentPath) do
      table.insert(fileList, name)
    end
  end
  refreshFiles()

  local running = true
  local function renderFileManager(win)
    gpu.setBackground(theme.window)
    for i, file in ipairs(fileList) do
      drawText(win.x + 2, win.y + i, file, theme.text)
    end
  end
  win.appFunc = renderFileManager

  while running do
    drawAllWindows() drawTaskbar()
    local e, addr, x, y, code = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, x, y)
      if action == "close" then running = false end
      if action == "minimize" then
        animateWindowTransition(win, win.x, screenHeight - taskbarHeight - 2, win.width, win.height, 0.3)
        win.minimized = true
      elseif action == "maximize" then
        if not win.maximized then
          win.origX = win.x; win.origY = win.y
          win.origWidth = win.width; win.origHeight = win.height
          animateWindowTransition(win, 1, 1, screenWidth, screenHeight - taskbarHeight, 0.5)
          win.maximized = true
        else
          animateWindowTransition(win, win.origX, win.origY, win.origWidth, win.origHeight, 0.5)
          win.maximized = false
        end
      elseif win.minimized then
        win.minimized = false
        animateWindowTransition(win, win.origX, win.origY, win.origWidth, win.origHeight, 0.3)
      elseif not (x >= win.x and x < win.x + win.width and y >= win.y and y < win.y + win.height) then
        running = false
      end
    end
  end

  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

