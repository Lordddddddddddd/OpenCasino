------------------------------
-- Приложение: Блокнот (Notepad)
------------------------------
local function appNotepad()
  updateDesktop() drawTaskbar()
  local win = createWindow("Блокнот", 10, 5, 50, 15, nil)
  local textLines = {""}
  local cursorX, cursorY = 1, 1
  local running = true

  local function renderNotepad(win)
    gpu.setBackground(theme.window)
    for i, line in ipairs(textLines) do
      drawText(win.x + 2, win.y + i, line, theme.text)
    end
    gpu.set(win.x + 2 + cursorX - 1, win.y + cursorY, "_")
  end

  win.appFunc = renderNotepad

  while running do
    drawAllWindows() drawTaskbar()
    local e, addr, x, y, buttonOrCode = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, x, y)
      if action == "close" then
        running = false
      elseif action == "minimize" then
        win.minimized = true
      elseif action == "maximize" then
        if not win.maximized then
          win.origX = win.x
          win.origY = win.y
          win.origWidth = win.width
          win.origHeight = win.height
          win.x = 1
          win.y = 1
          win.width = screenWidth
          win.height = screenHeight - taskbarHeight
          win.maximized = true
        else
          win.x = win.origX
          win.y = win.origY
          win.width = win.origWidth
          win.height = win.origHeight
          win.maximized = false
        end
      elseif win.minimized then
        -- При касании минимизированного окна, восстанавливаем его
        win.minimized = false
      end
    elseif e == "key_down" then
      if buttonOrCode == keyboard.keys.enter then
        cursorY = cursorY + 1
        cursorX = 1
        textLines[cursorY] = ""
      elseif buttonOrCode == keyboard.keys.back then
        if cursorX > 1 then
          local str = textLines[cursorY]
          textLines[cursorY] = str:sub(1, cursorX - 2) .. str:sub(cursorX)
          cursorX = cursorX - 1
        elseif cursorY > 1 then
          cursorX = #textLines[cursorY - 1] + 1
          textLines[cursorY - 1] = textLines[cursorY - 1] .. textLines[cursorY]
          table.remove(textLines, cursorY)
          cursorY = cursorY - 1
        end
      elseif buttonOrCode == keyboard.keys.escape then
        running = false
      else
        local ch = string.char(buttonOrCode)
        textLines[cursorY] = textLines[cursorY] .. ch
        cursorX = cursorX + 1
      end
    end
  end

  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

------------------------------
-- Приложение: Терминал
------------------------------
local function appTerminal()
  updateDesktop() drawTaskbar()
  local win = createWindow("Терминал", 15, 8, 60, 20, nil)
  local history = {}
  local inputLine = ""
  local running = true

  local function renderTerminal(win)
    gpu.setBackground(theme.window)
    local yOff = 1
    for i, line in ipairs(history) do
      if yOff < win.height - 2 then
        drawText(win.x + 2, win.y + yOff, line, theme.text)
        yOff = yOff + 1
      end
    end
    drawText(win.x + 2, win.y + yOff, "> " .. inputLine, theme.text)
  end

  win.appFunc = renderTerminal

  while running do
    drawAllWindows() drawTaskbar()
    local e, addr, x, y, code = event.pull()
    if e == "touch" then
      local action = checkWindowControls(win, x, y)
      if action == "close" then
        running = false
      elseif action == "minimize" then
        win.minimized = true
      elseif action == "maximize" then
        if not win.maximized then
          win.origX = win.x; win.origY = win.y
          win.origWidth = win.width; win.origHeight = win.height
          win.x = 1; win.y = 1
          win.width = screenWidth; win.height = screenHeight - taskbarHeight
          win.maximized = true
        else
          win.x = win.origX; win.y = win.origY
          win.width = win.origWidth; win.height = win.origHeight
          win.maximized = false
        end
      elseif win.minimized then
        win.minimized = false
      end
    elseif e == "key_down" then
      if code == keyboard.keys.enter then
        table.insert(history, "> " .. inputLine)
        inputLine = ""
      elseif code == keyboard.keys.back then
        inputLine = inputLine:sub(1, -2)
      elseif code == keyboard.keys.escape then
        running = false
      else
        inputLine = inputLine .. string.char(code or 0)
      end
      if #history > (win.height - 3) then table.remove(history, 1) end
    end
  end

  closeWindow(win.id)
  updateDesktop() drawTaskbar()
end

